# Copie para .env e preencha os valores reais. Nunca commite o .env de verdade.

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-aleatoria

# True apenas em desenvolvimento. Em produção, sempre False.
DEBUG=False

# Domínios permitidos, separados por vírgula (ex: meuapp.onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Em produção, a plataforma de hospedagem normalmente injeta essa variável
# automaticamente ao conectar um banco Postgres. Sem ela, cai no SQLite local.
DATABASE_URL=

# URL(s) do front em produção, separadas por vírgula (ex: a URL da Vercel:
# https://seu-app.vercel.app). Necessário pro CORS e pro CSRF aceitarem
# requisição vinda de um domínio diferente do backend. Deixe vazio em dev
# (o Vite já roda na mesma origem via proxy).
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Segundos que uma cotação fica em cache antes de buscar de novo na API externa.
COTACAO_CACHE_TTL=60

# Token opcional do brapi.dev (cadastro gratuito em https://brapi.dev).
BRAPI_TOKEN=

# Chave opcional da CoinGecko (plano Demo gratuito, cadastro em
# https://www.coingecko.com/en/developers/dashboard). Aumenta o limite de
# requisições por minuto nas buscas/cotações de cripto.
COINGECKO_API_KEY=
